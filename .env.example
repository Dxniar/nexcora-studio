# Create your own bot token at https://t.me/BotFather.
BOT_TOKEN=put_your_bot_token_here
# Required by Studio. Obtain your numeric Telegram ID with /myid.
ADMIN_ID=
# Legacy orderbot SQLite path; Studio uses DATABASE_URL below.
DB_PATH=data/orders.sqlite3

# Public contact username for the contact button, without @.
OWNER_USERNAME=your_telegram_username

# Nexcora Studio: configure separately; never overwrite your existing .env.
# Production requires HTTPS, PostgreSQL and all private Bucket credentials.
STUDIO_ENV=production
APP_ORIGIN=https://your-generated-domain.up.railway.app
DATABASE_URL=postgresql+psycopg://user:password@private-host:5432/database
S3_ENDPOINT=https://your-bucket-endpoint
S3_BUCKET=actual-bucket-name
S3_ACCESS_KEY_ID=replace-locally
S3_SECRET_ACCESS_KEY=replace-locally
S3_REGION=auto
S3_ADDRESSING_STYLE=virtual
# Leave empty unless the exact trusted proxy network has been verified.
TRUSTED_PROXY=
